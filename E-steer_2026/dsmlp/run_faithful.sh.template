#!/usr/bin/env bash
# Generated by submit_faithful.sh from dsmlp.env -- do not edit, and do not commit the generated copy.
# Runs INSIDE the DSMLP container (launch-scipy-ml.sh -B -- bash run_faithful.sh).
set -euo pipefail

# Container stdout/stderr go to a file under the project's results directory: it persists after the pod is deleted
# (unlike `kubectl logs`, https://dsmlp-docs.ucsd.edu/running-jobs/checkpointing/) and is visible from the login
# node. NOT the container's ~: that is the workspace home, a different directory from the login node's ~.
mkdir -p '__OUT_DIR__/logs'
LOG_FILE='__OUT_DIR__/logs/e-steer-faithful-__RUN_ID__.log'
exec >> "${LOG_FILE}" 2>&1
echo "=== $(date) start; run id __RUN_ID__; logging to ${LOG_FILE}"
nvidia-smi || echo "WARNING: nvidia-smi unavailable (no GPU visible?)"

export HF_HOME='__HF_HOME_DIR__'
export ESTEER_OUT_ROOT='__OUT_DIR__'
export ESTEER_RUN_ID='__RUN_ID__'
export ESTEER_ACK='__ACK__'
export ESTEER_NRC_VAD_PATH='__NRC_VAD_PATH__'
export ESTEER_MODEL_TIER='__MODEL_TIER__'     # auto: the hardware stage picks the tier on the GPU this job actually gets
export PYTHONUNBUFFERED=1
# Keep transformers from probing for TensorFlow (installed alongside PyTorch in the scipy-ml image); a probe
# deadlocked locally. esteer sets these too, exporting them here makes it independent of import order.
export USE_TF=0 USE_FLAX=0 TOKENIZERS_PARALLELISM=false
mkdir -p "${HF_HOME}" "${ESTEER_OUT_ROOT}"
[[ -z "${ESTEER_NRC_VAD_PATH}" ]] && unset ESTEER_NRC_VAD_PATH

if [[ ! -d '__VENV_DIR__' ]]; then
    echo "Creating venv __VENV_DIR__ (--system-site-packages: reuse the container's CUDA-matched PyTorch)"
    python3 -m venv --system-site-packages '__VENV_DIR__'
fi
source '__VENV_DIR__/bin/activate'
pip install -q -r '__PROJECT_DIR__/faithful/requirements.txt'

cd '__PROJECT_DIR__/faithful'
python -u -m pytest tests -q -x          # fast model-free sanity check of the installed environment
python -u -m esteer.run_experiment --profile '__PROFILE__' --stages '__STAGES__'
echo "=== $(date) finished run __RUN_ID__"
