#!/usr/bin/env bash
# Generated by submit_dsmlp.sh from dsmlp.env -- do not edit by hand, and do
# not commit the generated copy (it's git-ignored). Runs INSIDE the DSMLP
# container (invoked by launch-scipy-ml.sh -B -- bash run_job.sh).
set -euo pipefail

# A file in the home directory persists after the pod is deleted, unlike
# `kubectl logs`, which only works while the pod is alive -- see
# https://dsmlp-docs.ucsd.edu/running-jobs/checkpointing/
LOG_FILE="${HOME}/e-steer-dsmlp-$(date +%Y%m%d-%H%M%S).log"
exec > "${LOG_FILE}" 2>&1
echo "Logging to ${LOG_FILE}"

export HF_HOME='__HF_HOME_DIR__'
# Allow the first run to download the model weights into HF_HOME; later runs
# reuse the cache. (steer.py defaults to offline for local reproducibility.)
export ESTEER_HF_OFFLINE=0
export HF_HUB_OFFLINE=0
mkdir -p '__HF_HOME_DIR__' '__OUT_DIR__'

if [[ ! -d '__VENV_DIR__' ]]; then
    echo "Creating venv at __VENV_DIR__ (--system-site-packages to reuse the already-installed CUDA-matched PyTorch, per requirements-dsmlp.txt)"
    python3 -m venv --system-site-packages '__VENV_DIR__'
fi
source '__VENV_DIR__/bin/activate'
pip install -q -r '__PROJECT_DIR_ON_DSMLP__/requirements-dsmlp.txt'

cd '__PROJECT_DIR_ON_DSMLP__'
python -u steer.py --device cuda --out-dir '__OUT_DIR__'
python -u report.py --out-dir '__OUT_DIR__'
